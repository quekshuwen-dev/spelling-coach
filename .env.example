# ---------------------------------------------------------------------------
# Spelling Coach configuration
#
# The app RUNS WITH NOTHING FILLED IN:
#   - OCR falls back to Tesseract.js, which runs entirely in the browser.
#   - Words are stored on the device instead of in Firestore.
# Fill in a section to upgrade that part. Nothing here is required for the
# end-to-end journey (image -> OCR -> pick words -> test -> result) to work.
# ---------------------------------------------------------------------------

# === 1) FIREBASE — YOU NEED TO CONFIGURE THIS to sync across devices ========
# Firebase console -> Project settings -> Your apps -> Web app -> SDK config.
# These values are PUBLIC by design; your data is protected by firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# === 2) AI OCR — YOU NEED TO CONFIGURE THIS for best-quality scanning =======
# SERVER-SIDE ONLY. Never prefix these with VITE_ or the key ends up in the
# browser bundle where anyone can read it.
# OCR_PROVIDER: anthropic | openai | google-vision | none
OCR_PROVIDER=none
OCR_MODEL=
OCR_API_KEY=
# Optional:
# OCR_BASE_URL=
# OCR_TIMEOUT_MS=45000

# === 3) Local behaviour ====================================================
# Force the in-browser Tesseract engine even when a server key exists.
VITE_FORCE_LOCAL_OCR=false
