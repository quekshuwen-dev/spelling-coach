# Firebase web config for spelling-coach-61d31.
#
# These values are PUBLIC BY DESIGN. Vite inlines them into the built bundle,
# so they are served to every visitor and visible in any browser's dev tools —
# committing them changes nothing about who can see them. Firebase documents the
# apiKey as an identifier, not a secret.
#
# What actually protects the data is firestore.rules, which confines every user
# to their own subtree. Deploy the rules whenever they change:
#   npx firebase-tools deploy --only firestore:rules
#
# Committed rather than left to .env so that a build on any machine — yours,
# Firebase, Vercel — is configured with no extra setup.
VITE_FIREBASE_API_KEY=AIzaSyB6oi5U5nc0o9iKHPs8ZGqIr2LEqyOmEoI
VITE_FIREBASE_AUTH_DOMAIN=spelling-coach-61d31.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=spelling-coach-61d31
VITE_FIREBASE_STORAGE_BUCKET=spelling-coach-61d31.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1083014957925
VITE_FIREBASE_APP_ID=1:1083014957925:web:a2e7e331d6c4927e9baf8c
